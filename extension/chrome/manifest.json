{
  "manifest_version": 3,
  "name": "Draco Download Manager Integration",
  "short_name": "Draco",
  "version": "1.4.3",
  "description": "Sends downloads, videos and links to Draco Download Manager for fast multi-connection downloading.",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "contextMenus",
    "cookies",
    "webRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Draco Download Manager",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "mediaui.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "quick-capture": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Quick capture: download this page's video now (no dialog)"
    }
  },
  "author": "Md Hafijur Rahman"
}